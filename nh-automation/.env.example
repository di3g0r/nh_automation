# Copy this file to .env and fill in real values before running docker compose.

# --- Database ---
POSTGRES_USER=nh_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nh_automation
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nh_app:change-me@db:5432/nh_automation

# --- API / security ---
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=nh_session
CSRF_COOKIE_NAME=nh_csrf
ALLOWED_ORIGINS=https://localhost,http://localhost:5173
ENVIRONMENT=development

# --- Timezone (NFR-7a) ---
TZ=America/Mazatlan

# --- Networking (NFR-2) ---
# Comma-separated CIDRs allowed to reach /plc/v1 (checked in phase 4).
PLC_ALLOWED_NETWORKS=192.168.50.0/24

# --- Backups ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# --- Frontend (dev server) ---
VITE_API_BASE_URL=/api/v1
