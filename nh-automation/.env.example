# Copy this file to .env and fill in real values before running docker compose.

# --- Database ---
POSTGRES_USER=nh_app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nh_automation
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://nh_app:change-me@db:5432/nh_automation

# --- API / security ---
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=nh_session
CSRF_COOKIE_NAME=nh_csrf
ALLOWED_ORIGINS=https://localhost,http://localhost:5173
ENVIRONMENT=development

# --- Timezone (NFR-7a) ---
TZ=America/Mazatlan

# --- Networking (NFR-2) ---
# Comma-separated CIDRs allowed to reach /plc/v1 (checked in phase 4).
PLC_ALLOWED_NETWORKS=192.168.50.0/24

# --- External catalog database (phase 1 imports) ---
# The real product/packaging inventory lives in another database whose
# structure is not known yet. Leave empty to disable the "Base de datos
# externa" import source. Any SQLAlchemy URL (install its driver first) and a
# READ-ONLY user, e.g. mssql+pymssql://lectura:pw@10.0.0.5/ERP
# Query files: backend/external_sources/*.sql (see the README there).
EXTERNAL_CATALOG_DB_URL=
# EXTERNAL_PRODUCTS_QUERY_FILE=external_sources/products.sql
# EXTERNAL_PACKAGING_QUERY_FILE=external_sources/packaging_items.sql

# --- Backups ---
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=30

# --- Frontend (dev server) ---
VITE_API_BASE_URL=/api/v1
